### N&D Smart SchoolPay API Requests

@baseUrl = http://localhost:3000

# ==========================================
# AUTHENTICATION
# ==========================================

### Register Parent
# @name registerParent
POST {{baseUrl}}/auth/register/parent
Content-Type: application/json

{
  "name": "Jane Doe",
  "email": "jane@example.com",
  "phone": "1234567890",
  "password": "password123"
}

### Login Parent
# @name loginParent
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "jane@example.com",
  "password": "password123"
}

@parentToken = {{loginParent.response.body.token}}

### Register Driver
# @name registerDriver
POST {{baseUrl}}/auth/register/driver
Content-Type: application/json

{
  "name": "Alex Driver",
  "email": "alex@example.com",
  "phone": "0987654321",
  "password": "password123",
  "van_number": "VAN-999",
  "license_no": "LIC-111"
}

### Login Driver
# @name loginDriver
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "alex@example.com",
  "password": "password123"
}

@driverToken = {{loginDriver.response.body.token}}

### Login Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "Admin@123"
}

@adminToken = {{loginAdmin.response.body.token}}
@cronSecret = development_cron_secret_123

# ==========================================
# PARENT ENDPOINTS
# ==========================================

### Get Parent Profile
GET {{baseUrl}}/parent/profile
Authorization: Bearer {{parentToken}}

### Become Driver (Upgrade Account)
PATCH {{baseUrl}}/parent/become-driver
Content-Type: application/json
Authorization: Bearer {{parentToken}}

{
  "van_number": "VAN-555",
  "license_no": "LIC-777"
}

### Add Student (Child)
# @name addStudent
POST {{baseUrl}}/parent/students
Content-Type: application/json
Authorization: Bearer {{parentToken}}

{
  "name": "Little Jane",
  "grade": "1",
  "section": "A",
  "school_name": "Springfield Elementary",
  "pickup_location": "123 Main St"
}

@studentId = {{addStudent.response.body.student.id}}
@studentCode = {{addStudent.response.body.student.student_code}}

### Get Parent's Students
GET {{baseUrl}}/parent/students
Authorization: Bearer {{parentToken}}

### Get Specific Student
GET {{baseUrl}}/parent/students/{{studentId}}
Authorization: Bearer {{parentToken}}

### Get Student's Pickup Status Today
GET {{baseUrl}}/parent/students/{{studentId}}/pickup-status
Authorization: Bearer {{parentToken}}

### Get Parent Fees
GET {{baseUrl}}/parent/fees
Authorization: Bearer {{parentToken}}

### Pay a Fee (Parent Self-Pay)
PATCH {{baseUrl}}/parent/fees/{{feeId}}/pay
Authorization: Bearer {{parentToken}}

### Get Parent Notifications
GET {{baseUrl}}/parent/notifications
Authorization: Bearer {{parentToken}}

### Mark Parent Notification as Read
PATCH {{baseUrl}}/parent/notifications/{{notificationId}}/read
Authorization: Bearer {{parentToken}}

### Delete a Parent Notification
DELETE {{baseUrl}}/parent/notifications/{{notificationId}}
Authorization: Bearer {{parentToken}}

### Clear All Parent Notifications
DELETE {{baseUrl}}/parent/notifications
Authorization: Bearer {{parentToken}}


# ==========================================
# DRIVER ENDPOINTS
# ==========================================

### Get Driver Profile
GET {{baseUrl}}/driver/profile
Authorization: Bearer {{driverToken}}

### Toggle Duty Status (On Duty)
PATCH {{baseUrl}}/driver/status
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "is_on_duty": true
}

### Toggle Duty Status (Off Duty - sets active routes back to SCHEDULED)
PATCH {{baseUrl}}/driver/status
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "is_on_duty": false
}

### Create Morning Route (HOME_TO_SCHOOL)
# @name createMorningRoute
POST {{baseUrl}}/driver/routes
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "name": "Morning Pickup",
  "direction": "HOME_TO_SCHOOL",
  "start_time": "06:30",
  "end_time": "07:30"
}

@morningRouteId = {{createMorningRoute.response.body.route.id}}

### Create Evening Route (SCHOOL_TO_HOME)
# @name createEveningRoute
POST {{baseUrl}}/driver/routes
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "name": "Evening Dropoff",
  "direction": "SCHOOL_TO_HOME",
  "start_time": "14:30",
  "end_time": "16:00"
}

@eveningRouteId = {{createEveningRoute.response.body.route.id}}
@routeId = {{createMorningRoute.response.body.route.id}}

### Lookup Student by Code
GET {{baseUrl}}/driver/students/by-code/{{studentCode}}
Authorization: Bearer {{driverToken}}

### Add Student to Morning Route (with monthly_fee)
POST {{baseUrl}}/driver/routes/{{morningRouteId}}/students
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "student_code": "{{studentCode}}",
  "monthly_fee": 15000.00
}

### Add Student to Evening Route (omits monthly_fee to inherit existing fee)
POST {{baseUrl}}/driver/routes/{{eveningRouteId}}/students
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "student_code": "{{studentCode}}"
}

### Update Route (Name, Times, Direction)
PATCH {{baseUrl}}/driver/routes/{{morningRouteId}}
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "name": "Morning Pickup Route (Updated)",
  "start_time": "06:45"
}

### Archive Route
PATCH {{baseUrl}}/driver/routes/{{morningRouteId}}/archive
Authorization: Bearer {{driverToken}}

### Delete Route (only if no pickup history)
DELETE {{baseUrl}}/driver/routes/{{eveningRouteId}}
Authorization: Bearer {{driverToken}}

### Start Route (notifies parents)
POST {{baseUrl}}/driver/routes/{{morningRouteId}}/start
Authorization: Bearer {{driverToken}}

### Get Today's Routes
GET {{baseUrl}}/driver/routes/today
Authorization: Bearer {{driverToken}}

### Update Pickup Status (PICKED_UP - no charge)
PATCH {{baseUrl}}/driver/pickup/{{studentId}}
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "status": "PICKED_UP",
  "routeId": "{{morningRouteId}}"
}

### Update Pickup Status (DROPPED - charges 1 completed trip: monthly_fee/40)
PATCH {{baseUrl}}/driver/pickup/{{studentId}}
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "status": "DROPPED",
  "routeId": "{{morningRouteId}}"
}

### Remind Parents of Due Transport Fees
POST {{baseUrl}}/driver/fees/remind
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "month": 10,
  "year": 2026
}

### Remove Student from Route
DELETE {{baseUrl}}/driver/routes/{{routeId}}/students/{{studentId}}
Authorization: Bearer {{driverToken}}

### Get Pickup History
GET {{baseUrl}}/driver/history?date=2026-09-25&page=1&limit=50
Authorization: Bearer {{driverToken}}

### Get Student Fee Payment Status
GET {{baseUrl}}/driver/students/{{studentId}}/fees
Authorization: Bearer {{driverToken}}

### Pay Student Fee (Collect Payment)
PATCH {{baseUrl}}/driver/students/{{studentId}}/fees/{{feeId}}/pay
Content-Type: application/json
Authorization: Bearer {{driverToken}}

### Get Driver Notifications
GET {{baseUrl}}/driver/notifications
Authorization: Bearer {{driverToken}}

### Mark Driver Notification as Read
PATCH {{baseUrl}}/driver/notifications/{{notificationId}}/read
Authorization: Bearer {{driverToken}}

### Delete a Driver Notification
DELETE {{baseUrl}}/driver/notifications/{{notificationId}}
Authorization: Bearer {{driverToken}}

### Clear All Driver Notifications
DELETE {{baseUrl}}/driver/notifications
Authorization: Bearer {{driverToken}}

# ==========================================
# ADMIN ENDPOINTS
# ==========================================

### Get Pickups List (Filter by Status including DROPPED)
GET {{baseUrl}}/admin/pickups?status=DROPPED&page=1&limit=50
Authorization: Bearer {{adminToken}}

### Mark Pickup Status (Admin Override)
PATCH {{baseUrl}}/admin/pickups/{{pickupId}}/mark
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "DROPPED",
  "force": false
}

### Ticket-Based Pickup
POST {{baseUrl}}/admin/pickups/ticket
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "student_code": "{{studentCode}}",
  "route_id": "{{routeId}}"
}

### Generate Monthly Fees (All Active Students - Specific Month/Year)
POST {{baseUrl}}/admin/fees/generate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "month": 10,
  "year": 2026
}

### Generate Monthly Fees (All Active Students - Current Default)
POST {{baseUrl}}/admin/fees/generate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{}

# ==========================================
# CRON ENDPOINTS
# ==========================================

### Trigger Monthly Fee Generation Cron Job
GET {{baseUrl}}/cron/generate-fees
Authorization: Bearer {{cronSecret}}

